# Copy this file to `.env` and adjust the values. Never commit `.env`.

# --- Database (MySQL) ---
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Backend (taskflow-back) ---
DB_URL=jdbc:mysql://mysql:3306/taskflow
DB_USERNAME=taskflow
DB_PASSWORD=change-me
SERVER_PORT=8080

# --- Published host ports ---
BACK_PORT=8080
WEB_PORT=4200
